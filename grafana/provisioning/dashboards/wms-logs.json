{
  "id": null,
  "title": "WMS Logs Dashboard",
  "tags": [ "wms" ],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 0,
  "refresh": "5s",
  "time": {
    "from": "now-3d",
    "to": "now"
  },
  "panels": [
    {
      "type": "logs",
      "title": "Error Logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "{app=\"wms-backend\"} | json | level=`error`",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "type": "logs",
      "title": "Slow Requests (>500ms)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "id": 2,
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "{app=\"wms-backend\"} | json | context=`HTTP` |~ `\\\\[(?P<duration>\\\\d+)ms\\\\]` | duration > 500",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
